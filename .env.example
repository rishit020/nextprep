# --- Supabase: waitlist storage (required for the form to work) ---
# Project settings -> Data API (URL) and API Keys (anon/publishable key).
# The anon key is safe here: RLS grants it INSERT only, never SELECT.
# Copy this file to .env.local and fill both values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Resend: "someone joined" notification (optional) ---
# Leave blank to disable. Signups still save; only the notification is skipped.
# Get a key at resend.com. WAITLIST_NOTIFY_TO is where the alert lands.
RESEND_API_KEY=
WAITLIST_NOTIFY_TO=
# Must be a domain you verified in Resend. The default only works for sending
# to the address that owns the Resend account.
WAITLIST_NOTIFY_FROM=onboarding@resend.dev

# Optional: only needed to read signup ADDRESSES back (./scripts/waitlist.sh --list).
# Never expose this to the browser. Project Settings -> API Keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
